# Supabase Project URL (temukan di Supabase Dashboard -> Connect -> Next.js)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Publishable Key (direkomendasikan untuk frontend)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Legacy Anon Key (opsional untuk kompatibilitas mundur jika belum memakai publishable key)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

